# WordPress REST API source.
# Accepts a bare domain, a subdirectory multisite install, or a full wp-json URL —
# wp-fetch normalizes it to the site root.
WORDPRESS_URL=https://dooda.com.au/bestseoagencymelbourne/

# FormHub endpoint for the free audit form: https://<formhub-domain>/f/<publicKey>
# The FormHub site must list this site's origins (www and apex, plus
# http://localhost:3000 for development) or JSON submissions get a 403.
NEXT_PUBLIC_FORMHUB_ENDPOINT=

# Cloudflare Turnstile site key (public). The matching secret key goes into the
# form's settings in FormHub, never into this project. Leave empty to skip the
# widget. Cloudflare's always-pass test key for local work: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
